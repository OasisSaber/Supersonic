# 在仓库根目录复制为 .env；不要提交真实密钥或私人素材路径。
# 当前后端只实现 mock。local 与 api 是保留名称，设置后会明确拒绝启动。
APP_MODE=mock

# 本地演示的 Control 端点命令开关；默认关闭，仅显式设置后启用。
# CONTROL_ENABLED=true

# G4 平台持久化；缺失时现有 Mock HMI 继续无数据库运行。
# DATABASE_URL=postgresql+psycopg://supersonic:replace-me@127.0.0.1:5432/supersonic

# Destructive restore: use only an isolated local test database ending in _restore_test.
# RESTORE_DATABASE_URL=postgresql+psycopg://supersonic:replace-me@127.0.0.1:5432/supersonic_restore_test
# SUPERSONIC_ALLOW_DB_RESTORE=1

# GP05 前端 HTTP 与 WebSocket 主链路的 FastAPI 基地址。
VITE_API_URL=http://127.0.0.1:8000

# 仅供保留的旧 simulation Hook 使用，不控制 gp05.v1 主链路。
VITE_WS_URL=ws://127.0.0.1:8000/ws/simulation

# 以下名称为后续能力保留，当前运行时不会读取，也不代表能力已经实现：
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
# YOLO_MODEL_PATH=
# DEMO_VIDEO_PATH=
